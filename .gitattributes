# Line endings: store and check out text as LF on every OS
* text=auto eol=lf

*.lua  text eol=lf
*.json text eol=lf
*.cfg  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
LICENSE text eol=lf

# Binary assets: never touch line endings, no text diffs
*.png binary
*.jpg binary
*.ogg binary
*.zip binary

# Repository-only files, left out of `git archive` (the release zip).
# LICENSE, changelog.txt and thumbnail.png stay in: the game and the MIT terms need them.
.gitattributes export-ignore
.gitignore     export-ignore
.github/       export-ignore
docs/          export-ignore
tests/         export-ignore
README.md      export-ignore
